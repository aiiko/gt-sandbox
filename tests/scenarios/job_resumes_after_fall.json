      "by": 24
    },
    {
      "event": "action_resumed",
      "match": {"entity": "$tiny", "action": "work"},
      "after": 60
    },
    {
      "event": "job_done",
      "match": {"by": "$tiny"}
    },
    {
      "no_event": "reservation_released",
      "match": {"reason": "expired"}
    },
